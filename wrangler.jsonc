{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kov-career-api",
  "main": "cloudflare-api/worker.ts",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "containers": [
    {
      "class_name": "KOVBackend",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KOV_BACKEND",
        "class_name": "KOVBackend"
      }
    ]
  },
  "exports": {
    "KOVBackend": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
