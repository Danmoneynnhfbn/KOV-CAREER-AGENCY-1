{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kov-career-agency-1",
  "main": "cloudflare_worker.py",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
