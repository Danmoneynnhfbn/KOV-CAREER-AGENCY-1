{
  "version": 2,
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python"
    }
  ],
  "functions": {
    "server.py": {
      "includeFiles": "**/*.{html,xml,txt,png,jpg,jpeg,webp,gif,svg,ico}"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.py"
    },
    {
      "src": "/toba",
      "dest": "server.py"
    },
    {
      "src": "/(.*)",
      "dest": "server.py"
    }
  ]
}