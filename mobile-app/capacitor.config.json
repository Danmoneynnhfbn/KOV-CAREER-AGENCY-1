{
  "appId": "com.kovcareeragency.app",
  "appName": "KOV Career Agency",
  "webDir": "www",
  "server": {
    "url": "https://www.kovcareeragency.org",
    "cleartext": false,
    "allowNavigation": [
      "kovcareeragency.org",
      "*.kovcareeragency.org"
    ]
  },
  "backgroundColor": "#ffffff",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#ffffff",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}
